PORT=3000

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_mongodb_password
MONGO_DATABASE=touchgrass

MONGODB_URI=mongodb://admin:your_mongodb_password@localhost:27017/touchgrass?authSource=admin

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m

# Password reset email (Mailtrap, Ethereal or another SMTP provider)
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_URL=touchgrass://reset-password
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=Touch Grass <no-reply@touchgrass.local>

# Google Login: configure the client IDs created in Google Cloud Console
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# Apple Login remains disabled until the team has an Apple Developer account
# and an HTTPS callback. Never commit the real private key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICE_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
